#!/usr/bin/python3
# Grok usage collector bundled with Spaces Dock, copied from the author's
# m0sthatedman.agents plugin so the dock needs no other plugin. It prints the
# same record shape as Omarchy's omarchy-agent-usage-claude/-codex collectors.
# Token refresh is serialized with a lock in ~/.cache/omarchy/agent-usage that
# every copy of this collector shares, so two copies never refresh at once.
# Spaces Dock passes --no-refresh unless the user turns on "Refresh Grok
# sign-in", so by default ~/.grok/auth.json is only ever read.
"""Collect Grok Build usage into one display-ready JSON record.

Local stats come from Grok session files under ~/.grok/sessions (turn_completed
usage in updates.jsonl). Rate limits and the plan come from the same CLI-proxy
billing and settings endpoints the Grok `/usage` command uses. The agents panel
only ever reads the JSON this prints (or writes with --write).
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "grok"
AGENT_NAME = "Grok"
AUTH_HELP = "Run `grok login` to restore authoritative usage."
BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
SETTINGS_URL = "https://cli-chat-proxy.grok.com/v1/settings"
TOKEN_URL = "https://auth.x.ai/oauth2/token"
PROBE_MIN_INTERVAL_SECONDS = 15
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def grok_home() -> Path:
  return expand_path(os.environ.get("GROK_HOME") or "~/.grok")


def expand_path(value: str) -> Path:
  return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def usage_dir() -> Path:
  state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
  path = state / "omarchy" / "agents" / "usage"
  path.mkdir(parents=True, exist_ok=True)
  return path


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def local_date_from_timestamp(value: Any) -> str:
  if value is None:
    return local_date_string()
  if isinstance(value, (int, float)):
    try:
      seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
      return date_string(dt.datetime.fromtimestamp(seconds).date())
    except Exception:
      return local_date_string()
  raw = str(value).strip()
  if not raw:
    return local_date_string()
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    if parsed.tzinfo is not None:
      parsed = parsed.astimezone()
    return date_string(parsed.date())
  except Exception:
    return local_date_string()


def number(value: Any) -> int:
  try:
    n = float(value or 0)
    return round(n) if n == n else 0
  except Exception:
    return 0


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def empty_stats() -> dict[str, Any]:
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_date_strings()],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
    "hasLocalStats": True,
    "hasPromptStats": True,
  }


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def write_private_json(path: Path, payload: dict[str, Any]) -> None:
  """Atomically replace a credential file without relaxing its permissions."""
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
      handle.flush()
      os.fsync(handle.fileno())
    tmp.chmod(0o600)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    if time.time() - path.stat().st_mtime <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


# ---------------------------------------------------------------- local scan


def usage_from_object(usage: dict[str, Any]) -> tuple[int, int, int, int]:
  input_tokens = number(usage.get("inputTokens", usage.get("input_tokens")))
  output_tokens = number(usage.get("outputTokens", usage.get("output_tokens")))
  cache_read = number(
    usage.get("cachedReadTokens", usage.get("cacheReadInputTokens", usage.get("cache_read_input_tokens")))
  )
  cache_write = number(
    usage.get("cacheCreationTokens", usage.get("cacheCreationInputTokens", usage.get("cache_creation_input_tokens")))
  )
  return input_tokens, output_tokens, cache_read, cache_write


def add_bucket(target: dict[str, int], usage: dict[str, Any]) -> int:
  input_tokens, output_tokens, cache_read, cache_write = usage_from_object(usage)
  target["inputTokens"] += input_tokens
  target["outputTokens"] += output_tokens
  target["cacheReadInputTokens"] += cache_read
  target["cacheCreationInputTokens"] += cache_write
  return input_tokens + output_tokens + cache_read + cache_write


def scan_sessions(sessions_path: Path) -> dict[str, Any]:
  today = local_date_string()
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

  seen: set[str] = set()
  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0

  files = sessions_path.rglob("updates.jsonl") if sessions_path.is_dir() else []
  for path in files:
    session_key = path.parent.name
    try:
      with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line_number, line in enumerate(handle, 1):
          if "turn_completed" not in line or '"usage"' not in line:
            continue
          try:
            entry = json.loads(line)
          except Exception:
            continue

          params = entry.get("params") if isinstance(entry.get("params"), dict) else {}
          update = params.get("update") if isinstance(params.get("update"), dict) else {}
          if update.get("sessionUpdate") != "turn_completed":
            continue
          usage = update.get("usage")
          if not isinstance(usage, dict):
            continue

          unique_key = str(update.get("prompt_id") or params.get("sessionId") or f"{path}:{line_number}")
          if unique_key in seen:
            continue
          seen.add(unique_key)

          model_usage = usage.get("modelUsage") if isinstance(usage.get("modelUsage"), dict) else {}
          if not model_usage:
            model_usage = {str(usage.get("model") or "grok"): usage}

          meta = entry.get("_meta") if isinstance(entry.get("_meta"), dict) else {}
          day = local_date_from_timestamp(entry.get("timestamp") or meta.get("agentTimestampMs"))
          turn_total = 0
          for model, bucket in model_usage.items():
            if not isinstance(bucket, dict):
              continue
            model_id = str(model or "grok")
            acc = usage_by_model.setdefault(model_id, empty_bucket())
            added = add_bucket(acc, bucket)
            if added <= 0:
              continue
            turn_total += added
            if day == today:
              today_tokens[model_id] = today_tokens.get(model_id, 0) + added

          if turn_total <= 0:
            continue

          sessions.add(session_key)
          active_days.add(day)
          prompts += 1
          if day in recent:
            recent[day]["messageCount"] += turn_total
          if day == today:
            today_prompt_count += 1
            today_sessions.add(session_key)
            today_token_total += turn_total
    except Exception as exc:
      print(f"Ignoring unreadable Grok session file {path}: {exc}", file=sys.stderr)

  return {
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [recent[day] for day in recent_dates],
    "modelUsage": usage_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "hasLocalStats": True,
    "hasPromptStats": True,
  }


def cached_scan(sessions_path: Path, max_age_seconds: float) -> dict[str, Any]:
  cache_file = cache_root() / "grok-scan.json"
  lock_file = cache_root() / "grok-scan.lock"

  cached = read_fresh_json(cache_file, max_age_seconds)
  if cached is not None:
    return cached

  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    cached = read_fresh_json(cache_file, max_age_seconds)
    if cached is not None:
      return cached
    summary = scan_sessions(sessions_path)
    write_json(cache_file, summary)
    return summary


# ---------------------------------------------------------------- auth / limits


def oauth_record(home: Path) -> tuple[Path, dict[str, Any], str, dict[str, Any] | None]:
  path = home / "auth.json"
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return path, {}, "", None
  if not isinstance(data, dict):
    return path, {}, "", None

  preferred_key = ""
  preferred = None
  fallback_key = ""
  fallback = None
  for record_key, entry in data.items():
    if not isinstance(entry, dict) or not entry.get("key"):
      continue
    issuer = str(entry.get("oidc_issuer") or "")
    if preferred is None and ("auth.x.ai" in issuer or entry.get("auth_mode") == "oidc"):
      preferred_key = str(record_key)
      preferred = entry
    if fallback is None:
      fallback_key = str(record_key)
      fallback = entry
  return path, data, preferred_key or fallback_key, preferred or fallback


def oauth_login(home: Path) -> tuple[str, str, str]:
  _path, _data, _record_key, login = oauth_record(home)
  if not isinstance(login, dict):
    return "", "", ""
  return str(login.get("key") or ""), str(login.get("expires_at") or ""), str(login.get("auth_mode") or "")


def token_expired(expires_at: str) -> bool:
  raw = expires_at.strip()
  if raw == "":
    return False
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return False
  if parsed.tzinfo is None:
    parsed = parsed.replace(tzinfo=dt.timezone.utc)
  return parsed <= dt.datetime.now(dt.timezone.utc)


def token_refresh_due(expires_at: str) -> bool:
  raw = expires_at.strip()
  if raw == "":
    return False
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return False
  if parsed.tzinfo is None:
    parsed = parsed.replace(tzinfo=dt.timezone.utc)
  return parsed <= dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=2)


def refresh_oauth_login(home: Path) -> tuple[str, str, str]:
  """Use Grok's saved refresh token before declaring the sign-in expired.

  Grok stores an offline-access refresh token next to the short-lived access
  token. The indicator is a background client, so it cannot open an OAuth
  browser every time the access token rolls over; refreshing the same public
  OIDC client is the non-interactive path the saved credential is for.
  """
  lock_path = cache_root() / "grok-auth-refresh.lock"
  try:
    with lock_path.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      path, data, record_key, login = oauth_record(home)
      if not isinstance(login, dict):
        return "", "", ""

      access_token = str(login.get("key") or "")
      expires_at = str(login.get("expires_at") or "")
      auth_mode = str(login.get("auth_mode") or "")
      if access_token and not token_refresh_due(expires_at):
        return access_token, expires_at, auth_mode

      refresh_token = str(login.get("refresh_token") or "")
      client_id = str(login.get("oidc_client_id") or "")
      if not refresh_token or not client_id or not record_key:
        return access_token, expires_at, auth_mode

      body = urllib.parse.urlencode({
        "grant_type": "refresh_token",
        "refresh_token": refresh_token,
        "client_id": client_id,
      }).encode("utf-8")
      request = urllib.request.Request(
        TOKEN_URL,
        data=body,
        headers={
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "grok-cli/1.0.13",
        },
        method="POST",
      )
      try:
        with urllib.request.urlopen(request, timeout=10) as response:
          payload = json.loads(response.read().decode("utf-8", errors="replace"))
      except Exception:
        return access_token, expires_at, auth_mode
      if not isinstance(payload, dict) or not payload.get("access_token"):
        return access_token, expires_at, auth_mode

      refreshed = dict(login)
      refreshed["key"] = str(payload["access_token"])
      if payload.get("refresh_token"):
        refreshed["refresh_token"] = str(payload["refresh_token"])
      try:
        expires_in = max(60, int(float(payload.get("expires_in") or 3600)))
      except Exception:
        expires_in = 3600
      refreshed["expires_at"] = (
        dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=expires_in)
      ).isoformat().replace("+00:00", "Z")
      data[record_key] = refreshed
      write_private_json(path, data)
      return str(refreshed["key"]), str(refreshed["expires_at"]), str(refreshed.get("auth_mode") or "")
  except Exception:
    return oauth_login(home)


def cli_headers(access_token: str) -> dict[str, str]:
  return {
    "Authorization": "Bearer " + access_token,
    "X-XAI-Token-Auth": "xai-grok-cli",
    "Accept": "application/json",
    "User-Agent": "grok-cli/1.0.13",
  }


def http_get_json(url: str, headers: dict[str, str]) -> dict[str, Any]:
  request = urllib.request.Request(url, headers=headers)
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except urllib.error.HTTPError as error:
    if error.code == 401 or error.code == 403:
      return {"ok": False, "auth": True, "helpText": AUTH_HELP}
    if error.code == 429:
      return {
        "ok": False,
        "helpText": "xAI's usage endpoint is rate limiting checks right now. Local Grok stats are still shown.",
      }
    return {
      "ok": False,
      "helpText": f"xAI's usage endpoint returned status {error.code}. Local Grok stats are still shown.",
    }
  except Exception:
    return {
      "ok": False,
      "transport": True,
      "helpText": "Couldn't reach xAI's usage endpoint. Retrying shortly. Local Grok stats are still shown.",
    }
  if not isinstance(payload, dict):
    return {"ok": False, "helpText": "xAI's usage endpoint returned no limits. Local Grok stats are still shown."}
  return {"ok": True, "payload": payload}


def money_val(value: Any) -> float | None:
  if isinstance(value, dict) and "val" in value:
    try:
      return float(value.get("val"))
    except Exception:
      return None
  try:
    n = float(value)
  except Exception:
    return None
  return n


def period_title(period_type: str) -> str:
  text = str(period_type or "").upper()
  if "MONTH" in text:
    return "Monthly"
  if "WEEK" in text or "7" in text:
    return "Weekly"
  if "DAY" in text:
    return "Daily"
  return "Weekly"


def product_title(name: str, window: str) -> str:
  raw = str(name or "").strip()
  if raw == "":
    return window
  spaced = []
  buf = ""
  for ch in raw:
    if ch.isupper() and buf and not buf[-1].isupper():
      spaced.append(buf)
      buf = ch
    else:
      buf += ch
  if buf:
    spaced.append(buf)
  label = " ".join(spaced) if spaced else raw
  return f"{label} {window}"


def parse_billing(payload: dict[str, Any]) -> list[dict[str, Any]]:
  config = payload.get("config") if isinstance(payload.get("config"), dict) else payload
  period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
  window = period_title(str(period.get("type") or ""))
  resets_at = str(period.get("end") or config.get("billingPeriodEnd") or "")

  percent_raw = config.get("creditUsagePercent")
  if percent_raw is None:
    used = money_val(config.get("used") or config.get("onDemandUsed"))
    cap = money_val(config.get("monthlyLimit") or config.get("onDemandCap"))
    if used is not None and cap and cap > 0:
      percent_raw = (used / cap) * 100.0
    elif period.get("type") or period.get("start") or period.get("end"):
      # The credits service uses proto3 JSON. At the start of a period an
      # exact-zero creditUsagePercent is omitted, while currentPeriod remains
      # present. That is a valid 0% window, not an unsupported response.
      percent_raw = 0.0

  limits: list[dict[str, Any]] = []
  try:
    percent = float(percent_raw)
  except Exception:
    percent = -1.0
  if percent >= 0:
    # xAI specifies creditUsagePercent in percentage points from 0 to 100.
    # In particular, 1.0 means 1%, not a pre-scaled fraction meaning 100%.
    fraction = min(1.0, max(0.0, percent / 100.0))
    limits.append({
      "label": f"{window} (7-day)" if window == "Weekly" else window,
      "title": window,
      "percent": fraction,
      "resetsAt": resets_at,
    })

  products = config.get("productUsage")
  if isinstance(products, list):
    for entry in products:
      if not isinstance(entry, dict):
        continue
      name = str(entry.get("product") or "").strip()
      try:
        product_percent = float(entry.get("usagePercent"))
      except Exception:
        continue
      if name == "" or product_percent < 0:
        continue
      title = product_title(name, window)
      if any(item.get("title") == title for item in limits):
        continue
      # Skip a product meter that just restates the overall window.
      if len(products) == 1 and limits:
        continue
      fraction = min(1.0, max(0.0, product_percent / 100.0))
      limits.append({
        "label": title,
        "title": title,
        "percent": fraction,
        "resetsAt": resets_at,
      })
  return limits


def parse_tier(payload: dict[str, Any]) -> str:
  if not isinstance(payload, dict):
    return ""
  for key in ("subscription_tier_display", "subscriptionTierDisplay", "subscription_tier"):
    value = payload.get(key)
    if isinstance(value, str) and value.strip():
      return value.strip()
  return ""


def probe_limits(access_token: str) -> dict[str, Any]:
  headers = cli_headers(access_token)
  billing = http_get_json(BILLING_URL, headers)
  if not billing.get("ok"):
    return billing

  limits = parse_billing(billing["payload"])
  settings = http_get_json(SETTINGS_URL, headers)
  tier = parse_tier(settings.get("payload") or {}) if settings.get("ok") else ""

  if not limits:
    return {
      "ok": False,
      "helpText": "xAI's usage endpoint returned no limits. Local Grok stats are still shown.",
      "tierLabel": tier,
    }
  return {"ok": True, "limits": limits, "tierLabel": tier}


def limit_window_open(entry: dict[str, Any], now: dt.datetime) -> bool:
  raw = str(entry.get("resetsAt") or "")
  if raw == "":
    return True
  try:
    resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
  return resets_at > now


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = dt.datetime.now(dt.timezone.utc)
  return [entry for entry in entries if isinstance(entry, dict) and limit_window_open(entry, now)]


def collect_limits(access_token: str, expires_at: str, force: bool) -> dict[str, Any]:
  result = {
    "limits": [],
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
  }

  probe_cache = cache_root() / "grok-limits.json"
  cached = read_fresh_json(probe_cache, float("inf")) or {}
  fallback = usable_cached_limits(cached)
  cached_tier = str(cached.get("tierLabel") or "")

  if access_token == "":
    result["limits"] = fallback
    result["tierLabel"] = cached_tier
    result["usageStatusText"] = "Waiting for auth"
    return result
  if token_expired(expires_at):
    result["limits"] = fallback
    result["tierLabel"] = cached_tier
    result["usageStatusText"] = "Sign-in expired"
    result["authHelpText"] = (
      "Grok's saved sign-in expired"
      + (" — showing the last known limits." if fallback else ".")
      + " Run `grok login` to refresh it."
    )
    return result

  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    result["limits"] = fallback
    result["tierLabel"] = cached_tier
    return result

  probe = probe_limits(access_token)
  if probe.get("ok"):
    result["limits"] = probe["limits"]
    result["tierLabel"] = str(probe.get("tierLabel") or cached_tier)
    write_json(
      probe_cache,
      {
        "fetchedAtMs": round(time.time() * 1000),
        "limits": probe["limits"],
        "tierLabel": result["tierLabel"],
      },
    )
    return result

  if probe.get("transport"):
    result["retryAdvised"] = True
  if fallback:
    result["limits"] = fallback
    result["tierLabel"] = cached_tier
  else:
    result["usageStatusText"] = "Grok limits unavailable"
    result["authHelpText"] = str(probe.get("helpText") or AUTH_HELP)
  if probe.get("tierLabel"):
    result["tierLabel"] = str(probe["tierLabel"])
  return result


# -------------------------------------------------------------------- record


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan sessions and re-probe limits, ignoring caches")
  parser.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the limits probe must be fresh")
  parser.add_argument("--write", action="store_true", help="write ~/.local/state/omarchy/agents/usage/grok.json")
  parser.add_argument("--no-refresh", action="store_true", help="never renew the Grok CLI token; only read ~/.grok/auth.json")
  parser.add_argument("--cache-seconds", type=float, default=SCAN_REUSE_SECONDS)
  args = parser.parse_args()

  home = grok_home()
  scan_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else args.cache_seconds)
  stats = cached_scan(home / "sessions", scan_age)

  access_token, expires_at, _auth_mode = oauth_login(home)
  if access_token and token_refresh_due(expires_at) and not args.no_refresh:
    access_token, expires_at, _auth_mode = refresh_oauth_login(home)
  limits = collect_limits(access_token, expires_at, args.force)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": number(stats.get("totalPrompts")) > 0 or len(limits["limits"]) > 0,
    "hasLocalStats": True,
    "hasPromptStats": True,
    "tierLabel": limits.get("tierLabel") or "",
    "usageStatusText": limits["usageStatusText"],
    "authHelpText": limits["authHelpText"],
    "limits": limits["limits"],
  }
  if limits.get("retryAdvised"):
    record["retryAdvised"] = True
  record.update(stats)
  payload = json.dumps(record, separators=(",", ":"), sort_keys=True)
  print(payload)
  if args.write:
    write_json(usage_dir() / "grok.json", record)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
